# Copy this file to .env and fill in values from your own Volcengine account.
# Never commit the real .env file.

# Runtime mode. Production disables Swagger and cost-bearing debug endpoints.
APP_ENV=development

# Optional comma-separated origins for a separately hosted frontend.
# The recommended production deployment serves React and FastAPI on one origin.
CORS_ORIGINS=

# Volcengine account credentials used to sign RTC and Knowledge Base requests.
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# Ark / Doubao model endpoint.
ARK_ENDPOINT_ID=
ARK_API_KEY=

# RTC application and token-signing information.
RTC_APP_ID=
RTC_APP_KEY=
RTC_ROOM_ID=ChatRoom01
RTC_USER_ID=Huoshan01
RTC_TASK_ID=ChatTask01
RTC_AGENT_USER_ID=AiAgent

# ASR and TTS application identifier.
SPEECH_APP_ID=

# Public HTTPS URL that Volcengine can call, for example an ngrok URL.
# On Render this can stay empty because RENDER_EXTERNAL_URL is detected.
SERVER_URL=

# Private Bearer token shared only between RTC and the public callback service.
CALLBACK_AUTH_TOKEN=

# VikingDB Knowledge Base information.
KB_COLLECTION_NAME=
KB_PROJECT_NAME=default
VOLC_ACCOUNT_ID=

# Text spoken after the AI agent joins the RTC room.
WELCOME_MESSAGE=我是懂小智，你的专属课程顾问，有什么问题可以直接问我。
